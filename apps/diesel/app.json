{
  "id": "diesel",
  "title": "Diesel",
  "description": "For B47 / B57 diesels: the particulate filter's soot and ash, a clear warning while a regeneration runs (don't switch off), a log of regenerations, about how far the next one is, and a home-screen widget. Starts with the car and records every drive for calibration. Read-only",
  "version": "0.2.1",
  "vendor": "custom",
  "loggingId": "OAD1",
  "iconGlyph": "DPF",
  "mguHmi": ["ID7"],
  "autostart": true,
  "requires": { "idrive7-renderd": "2.1.15" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "startWidget": {
    "comment": "Home-screen widget, as eDrive's and Live Data's: the layout and cell names of BMW's Drive Recorder widget; the drawn picture goes into BackgroundImage1. If it sits wrong on the G30, adjust 'size' and 'safe' (the share of each edge the HMI crops).",
    "name": "Diesel",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "scale": 2,
    "size": [384, 256],
    "safe": [0.09, 0.17],
    "cells": {
      "ErrorInfo": [false, "Bool"],
      "background": [true, "Bool"],
      "ProgressbarVisible": [false, "Bool"],
      "TextRecordings": ["", "Text"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Diesel",
      "buttons": [
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
      "key": "sootMax",
      "label": "Soot gauge ends at",
      "type": "number",
      "unit": "g",
      "default": 30,
      "steps": [20, 25, 30, 40, 50]
    },
    {
      "key": "regenTemp",
      "label": "Regeneration: hotter before the filter than",
      "type": "number",
      "unit": "°C",
      "default": 500,
      "steps": [450, 500, 550, 600]
    },
    {
      "key": "watch",
      "label": "Keep watching with the screen closed",
      "type": "bool",
      "default": true
    },
    {
      "key": "record",
      "label": "Record drives (CSV, for calibration)",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        ["m_red", "M Red"],
        ["m_tricolour", "M Tricolour"],
        ["ice", "Ice White"],
        ["amber", "Night Amber"]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [["full", "Full screen"], ["standard", "Standard"]]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]
    }
  ]
}
